# Database — Transaction Pooler (used by the app at runtime, serverless-safe)
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"
# Database — Direct connection (used for migrations only; DDL fails through the pooler)
DATABASE_URL_DIRECT="postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Passkey Configuration
PASSKEY_RP_NAME="Restock app"
PASSKEY_RP_ID="localhost"
PASSKEY_ORIGIN="http://localhost:5173"

JWT_SECRET="your-secret-here"

# Sentry — error tracking
# Get from: sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry source map upload (build-time only, add to Vercel env vars)
# Get from: sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# Axiom — structured logs
# next-axiom reads this automatically when set
# Get from: axiom.co → Settings → API Tokens
NEXT_AXIOM_TOKEN=your-axiom-api-token
NEXT_AXIOM_DATASET=restock-logs
